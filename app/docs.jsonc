{
  "$schema": "https://holocron.so/docs.json",
  "name": "Sigillo",
  "description": "Self-hostable secrets manager for humans & agents",
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#16a34a"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "layout": {
    "mode": "compact"
  },
  "navbar": {
    "links": [
      { "label": "GitHub", "icon": "github", "href": "https://github.com/kldzj/sigillo" }
    ],
    "primary": {
      "type": "button",
      "label": "Self-host",
      "href": "/docs/self-hosting"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "lucide:book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "lucide:rocket",
            "pages": ["index", "docs/self-hosting", "docs/quick-start", "docs/doppler-migration"]
          },
          {
            "group": "Use Sigillo",
            "icon": "lucide:terminal",
            "pages": ["docs/workload-identity"]
          },
          {
            "group": "Security",
            "icon": "lucide:shield-check",
            "pages": ["docs/hardening"]
          },
          {
            "group": "Run your instance",
            "icon": "lucide:server-cog",
            "pages": ["docs/updating", "docs/backups", "docs/rotate-key", "docs/from-source"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "lucide:plug",
        "openapi": "openapi.json"
      },
      {
        "tab": "CLI Reference",
        "icon": "lucide:terminal",
        "groups": [
          {
            "group": "Overview",
            "icon": "lucide:info",
            "pages": ["docs/cli/index"]
          },
          {
            "group": "Auth & Setup",
            "icon": "lucide:log-in",
            "pages": ["docs/cli/login", "docs/cli/logout", "docs/cli/me", "docs/cli/setup"]
          },
          {
            "group": "Secrets",
            "icon": "lucide:lock",
            "pages": ["docs/cli/run", "docs/cli/secrets", "docs/cli/secrets-get", "docs/cli/secrets-set", "docs/cli/secrets-delete", "docs/cli/secrets-download"]
          },
          {
            "group": "Organizations",
            "icon": "lucide:building-2",
            "pages": ["docs/cli/orgs", "docs/cli/orgs-create"]
          },
          {
            "group": "Projects",
            "icon": "lucide:folder",
            "pages": ["docs/cli/projects", "docs/cli/projects-create", "docs/cli/projects-get", "docs/cli/projects-update", "docs/cli/projects-delete"]
          },
          {
            "group": "Environments",
            "icon": "lucide:layers",
            "pages": ["docs/cli/environments", "docs/cli/environments-create", "docs/cli/environments-get", "docs/cli/environments-rename", "docs/cli/environments-delete"]
          },
          {
            "group": "Audit",
            "icon": "lucide:shield-check",
            "pages": ["docs/cli/audit-verify"]
          },
          {
            "group": "Self-hosting",
            "icon": "lucide:server",
            "pages": ["docs/cli/self-host"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        { "anchor": "GitHub", "href": "https://github.com/kldzj/sigillo", "icon": "lucide:github" },
        { "anchor": "Changelog", "href": "https://github.com/kldzj/sigillo/releases", "icon": "lucide:newspaper" }
      ]
    }
  },
  // A static site: the assistant needs a server
  "assistant": {
    "enabled": false
  },
  "decorativeLines": "none"
}
